{
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__claude-code-remote"
    ],
    "deny": [
      "Bash(*reset-kubernetes.yml*)",
      "Bash(*uninstall-kubernetes.yml*)",
      "Bash(kubectl delete:*)",
      "Bash(helm uninstall:*)",
      "Bash(rm -rf:*)",
      "Bash(*vault-pass*)",
      "Bash(*ansible-vault*)",
      "Read(~/.config/homelab/**)",
      "Read(//etc/homelab/**)",
      "Edit(~/source/ansible-files/**)",
      "Edit(~/.config/homelab/**)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(*sudo *)"
    ]
  }
}
